# Supabase (EU / Ireland)
# Frontend (Vercel env) — the only VITE_ vars that exist.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Read by Edge Functions, but AUTO-INJECTED by the Supabase runtime —
# never needs to be set in Vercel or Supabase secrets.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Edge secrets). Payment links + webhook stay dormant until set.
VITE_STRIPE_PUBLISHABLE_KEY=   # optional frontend gate only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Scribe — LiteLLM gateway (preferred, set these) or direct keys (fallback).
# The gateway must be EU-hosted (consultation audio flows through it).
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Optional model overrides (provider prefixes depend on your LiteLLM router):
# AI_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# AI_STRUCTURE_MODEL=anthropic/claude-haiku-4-5
# Gateway keys without audio models: transcribe via a chat model instead
# AI_TRANSCRIBE_VIA_CHAT=true
# AI_TRANSCRIBE_CHAT_MODEL=gemini-3.8-flash
# Monthly AI spend cap in euro cents (shared by scribe + chat)
# AI_MONTHLY_CAP_CENTS=500
# Síle chat feature flag (runtime-toggleable; scribe/briefing unaffected)
# SILE_CHAT_ENABLED=true
# Síle premium voice (Phase 3, testing) — ElevenLabs TTS proxied through the
# sile-tts edge function so the key never reaches the browser. Client toggle is
# the silePremiumVoice feature flag (Settings). NOTE: reply text can contain
# patient identifiers — point ELEVENLABS_BASE_URL at an EU-residency endpoint
# (or complete DPA + zero-retention) and flip the flag default to false before
# production.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL      # default: "Sarah"
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Calendar (per clinician — Edge secrets, never VITE_)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Origin used for OAuth redirects + link building. Must be the deployed
# Vercel URL in production Supabase secrets (localhost only for local dev).
PUBLIC_APP_URL=http://localhost:4173

# Email (Resend — Edge secret). Booking confirmations + workflow email actions
# are sent from here; gracefully skipped while unset.
RESEND_API_KEY=
RESEND_FROM=Cúram <beth.t@example.com>

# Voice (Síle) — Edge secret only, never VITE_. Voice agent sends x-booking-key.
BOOKING_API_KEY=

# SMS / WhatsApp (Twilio — Edge secrets, never VITE_)
# Messaging stays OFF until you set SMS_ENABLED=true in Edge secrets.
# Channel: 'sms' (default) or 'whatsapp' (requires Twilio WhatsApp-enabled sender).
SMS_ENABLED=false
TWILIO_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Header key pg_cron sends to cron functions (reminders, workflow, inbox)
CRON_SECRET=

# VoiceHub (sister app) — AI receptionist. Onboarding links out here with
# practice details pre-filled; the provisioning API will make it one-click.
VITE_VOICEHUB_URL=https://app.voicehub.uk

# Error monitoring (Sentry). Free Developer plan is enough to start.
# VITE_SENTRY_DSN → Vercel env (web app). SENTRY_DSN → Supabase secrets
# (Edge Functions). EXPO_PUBLIC_SENTRY_DSN → patient app env.
# Never send PHI to Sentry — scope events with tags only.
VITE_SENTRY_DSN=
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# HealthLink bridge bootstrap key (per-agent keys are issued from it)
BRIDGE_API_KEY=
