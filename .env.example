# Supabase (EU / Ireland)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Calendar (per clinician — Edge secrets, never VITE_)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:4173
# After Vercel: PUBLIC_APP_URL=https://your-app.vercel.app

# Email (Resend — Edge secret). Patient confirmation is sent separately from GP notice.
RESEND_API_KEY=
RESEND_FROM=Cúram <beth.t@example.com>

# Voice (Síle) — Edge secret only, never VITE_. Voice agent sends x-booking-key.
VAPI_API_KEY=
BOOKING_API_KEY=

# SMS / WhatsApp (Twilio — Edge secrets, never VITE_)
# Messaging stays OFF until you set SMS_ENABLED=true in Edge secrets.
# Channel: 'sms' (default) or 'whatsapp' (requires Twilio WhatsApp-enabled sender).
SMS_ENABLED=false
TWILIO_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Header key that pg_cron sends to the reminders function
CRON_SECRET=c7f4a9d2e86b41f0a5c3d7e9b2f64a18

# Bridge
BRIDGE_API_KEY=
CURAM_INGEST_URL=
