{
  "name": "curam-healthlink-bridge",
  "productName": "Cúram HealthLink Bridge",
  "version": "0.1.0",
  "description": "Local bridge agent that moves HL7 v2.4 messages between HealthLink and Cúram",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "build": {
    "appId": "ie.curam.healthlink.bridge",
    "files": ["dist/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "autoStartOnLaunch": true },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.medical"
    }
  }
}
