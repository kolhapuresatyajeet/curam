# Test-only env for `supabase functions serve` — used exclusively by the
# automated email suite (tests/email/full-loop.test.mjs, gated behind
# CURAM_FULL_LOOP=1). NEVER deploy these values to Supabase secrets:
# HEALTHMAIL_TEST_MODE relaxes @healthmail.ie validation to also accept
# @ethereal.email (the fake-SMTP capture provider), and must never be
# enabled in production.
HEALTHMAIL_TEST_MODE=true
HEALTHMAIL_ENABLED=true
HEALTHMAIL_SMTP_HOST=smtp.ethereal.email
